@using UI.Auth
@inject AuthService AuthService
@implements IDisposable
@page "/estate"

@if (AuthService.EstateId == null)
{
    <p>You need to create your estate.</p>
}
else
{
    <p>Welcome back to @AuthService.EstateName.</p>
}

@code {
    protected override void OnInitialized()
    {
        AuthService.UserChanged += OnUserChanged;
    }

    private void OnUserChanged(System.Security.Claims.ClaimsPrincipal _)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.UserChanged -= OnUserChanged;
    }
}