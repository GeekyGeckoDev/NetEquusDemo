@page "/createsystemestate"

@using Application.EstateApp.EstateDtos
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Shared.Dtos.NpcDtos
@using Shared.Dtos.OwnershipDtos
@using Shared.Dtos.UserDtos
@using Shared.Dtos.WrapperDto
@using UI.API.Clients

@rendermode InteractiveServer
@inject EstateClient EstateClient
@inject NpcClient UserClient

<h3>Create System Estate</h3>

<AuthorizeView Roles="Admin">

    <Authorized>

        <div class="container mt-4">



            <div class="card shadow p-4 col-md-6 mx-auto">

                <h4 class="mb-4 text-center">
                    Create System Estate
                </h4>

                @if (!string.IsNullOrEmpty(responseMessage))
                {
                    <div class="alert alert-info">
                        @responseMessage
                    </div>
                }

                <!-- NPC Dropdown -->
                <div class="mb-3">

                    <label class="form-label">
                        Select NPC
                    </label>

                    <select class="form-select"
                            @bind="selectedNpcId">

                        <option value="">
                            -- Select NPC --
                        </option>

                        @foreach (var npc in npcs)
                        {
                            <option value="@npc.UserId">
                                @npc.Username
                            </option>
                        }

                    </select>

                </div>

                <!-- Empty Estate Name -->
                <div class="mb-3">

                    <label class="form-label">
                        Estate Name
                    </label>

                    <input class="form-control" @bind="newEstate.Estate.EstateName" />

                </div>

                <button class="btn btn-primary w-100" @onclick="CreateAsync">
                    Create Estate
                </button>

            </div>

        </div>

    </Authorized>

    <NotAuthorized>

        <div class="container mt-5 text-center">
            <h5>
                You are not authorized to access this page.
            </h5>
        </div>

    </NotAuthorized>

</AuthorizeView>

@code {

    private List<NpcDto> npcs = new();

    private Guid? selectedNpcId;

    private string? estateName;

    private string? responseMessage;

    private CreateNpcEstateRequest newEstate = new CreateNpcEstateRequest
        {
            Estate = new EstateCreationDto(),
            Ownership = new EstateOwnershipDto()
        };

    protected override async Task OnInitializedAsync()
    {
        npcs = await UserClient.GetNpcsWithoutEstatesAsync();
    }

    private async Task CreateAsync()
    {
        if (selectedNpcId == null)
        {
            responseMessage = "Please select an NPC.";
            return;
        }

        newEstate.UserId = selectedNpcId.Value;

        var response = await EstateClient.CreateNpcEstateAsync(newEstate);

        if (response.IsSuccessStatusCode)
        {
            responseMessage = "Estate created successfully!";

            newEstate = new CreateNpcEstateRequest
            {
                Estate = new EstateCreationDto(),
                Ownership = new EstateOwnershipDto()
            };

            selectedNpcId = null;
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            responseMessage = $"Creation failed: {error}";
        }
    }

}