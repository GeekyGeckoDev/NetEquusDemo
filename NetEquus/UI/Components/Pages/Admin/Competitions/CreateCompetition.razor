@page "/create-competition"

@using Shared.Dtos.CompetitionDtos
@using Shared.Dtos.CompetitionDtos.CompDisciplineDtos
@using UI.API.Clients

@inject CompetitionClient CompetitionClient
@inject CompetitionClassClient CompetitionClassClient

@rendermode InteractiveServer

<h3>Create Competition</h3>

@if (!string.IsNullOrEmpty(responseMessage))
{
    <div class="alert alert-info">
        @responseMessage
    </div>
}

<div class="mb-3">
    <label class="form-label">Competition Class</label>

    <select class="form-select" @bind="dto.CompetitionClassId">
        <option value="@Guid.Empty">Select a class...</option>

        @foreach (var competitionClass in competitionClasses)
        {
            <option value="@competitionClass.CompetitionClassId">
                @competitionClass.CompetitionDisciplineName - @competitionClass.Name
            </option>
        }
    </select>
</div>

<button class="btn btn-primary"
        @onclick="CreateCompetitionAsync">
    Create Competition
</button>



@code {

    private string? responseMessage;

    private CreateCompetitionDto dto = new()
    {
        Date = DateTime.UtcNow
    };

    private List<CompetitionClassDto> competitionClasses = new();

    protected override async Task OnInitializedAsync()
    {
        competitionClasses =
            await CompetitionClassClient.GetAllCompetitionClassesAsync();
    }


    private async Task CreateCompetitionAsync()
    {
        var response = await CompetitionClient.CreateCompetitionAsync(dto);

        if (response.IsSuccessStatusCode)
        {
            responseMessage = "Competition created successfully!";

            dto = new CreateCompetitionDto
            {
                Date = DateTime.UtcNow
            };
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            responseMessage = $"Creation failed: {error}";
        }
    }
}