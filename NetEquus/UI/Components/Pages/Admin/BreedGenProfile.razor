@page "/breedgenprofile"
@using Shared.Dtos
@using Shared.Dtos.BreedDtos
@using Shared.Dtos.WrapperDto
@using UI.API.Clients
@rendermode InteractiveServer

@inject BreedClient breedClient
@inject BreedGenStatsClient breedGenStatsClient
@inject NavigationManager Nav

<h3>Breed Generation Ranges</h3>

<div class="mb-3">
    <label class="form-label">Breed</label>

    <select class="form-select" @bind="SelectedBreedId">
        <option value="">-- Select Breed --</option>

        @foreach (var breed in Breeds)
        {
            <option value="@breed.BreedId">
                @breed.BreedName
            </option>
        }
    </select>
</div>

    <table class="table table-bordered table-striped align-middle">
        <thead>
            <tr>
                <th style="width:40%">Stat</th>
                <th style="width:30%">Min</th>
                <th style="width:30%">Max</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var stat in StatRanges)
            {
                <tr>
                <td>@stat.GenStat</td>

                    <td>
                        <input class="form-control"
                               type="number"
                               step="0.1"
                               @bind="stat.Min" />
                    </td>

                    <td>
                        <input class="form-control"
                               type="number"
                               step="0.1"
                               @bind="stat.Max" />
                    </td>
                </tr>
            }

        </tbody>
    </table>

    <button class="btn btn-primary"
            @onclick="Save">
        Save
    </button>

@code
{
    private Guid? SelectedBreedId;

    private List<BreedInfoDto> Breeds = new();

    private List<BreedGenerationStatDto> StatRanges = new()
    {
        new() { GenStat = GenerationStat.Gaits
        },
        new() { GenStat = GenerationStat.Scope },
        new() { GenStat = GenerationStat.Speed },
        new() { GenStat = GenerationStat.Agility },
        new() { GenStat = GenerationStat.Endurance },
        new() { GenStat = GenerationStat.Stride },
        new() { GenStat = GenerationStat.Trainability },

        new() { GenStat = GenerationStat.Legs },
        new() { GenStat = GenerationStat.Shoulders },
        new() { GenStat = GenerationStat.Hindquarters },
        new() { GenStat = GenerationStat.Pasterns },
        new() { GenStat = GenerationStat.BackAndLoin },

        new() { GenStat = GenerationStat.Head },
        new() { GenStat = GenerationStat.Neck },
        new() { GenStat = GenerationStat.ChestAndBarrel },
        new() { GenStat = GenerationStat.BackAndTopLine, }
    };

    protected override async Task OnInitializedAsync()
    {
        Breeds = await breedClient.GetALlBreedsAsync();
    }


    private async Task Save()
    {
        var dto = new BreedGenerationProfileDto
        {
            BreedId = SelectedBreedId.Value,
            Stats = StatRanges
        };

        await breedGenStatsClient.UpdateBreedGenProfileAsync(dto);
    }
}