@page "/create-competition-discipline"

@using Shared.Dtos
@using Shared.Dtos.CompetitionDtos
@using Shared.Dtos.CompetitionDtos.CompDisciplineDtos
@using Shared.Enums
@using UI.API.Clients
@rendermode InteractiveServer

@inject CompetitionDisciplineClassClient CompetitionClient

<h3>Create Competition Discipline</h3>

<div class="mb-3">
    <label class="form-label">Discipline</label>

    <select class="form-select" @bind="dto.Discipline">
        @foreach (var discipline in Enum.GetValues<Discipline>())
        {
            <option value="@discipline">
                @discipline
            </option>
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Class Name</label>

    <input type="text"
           class="form-control"
           @bind="dto.ClassName" />
</div>

<div class="mb-3">
    <label class="form-label">Level</label>

    <input type="number"
           class="form-control"
           @bind="dto.Level" />
</div>

<h5>Stat Requirements</h5>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Generation Stat</th>
            <th>Weight</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var requirement in dto.Requirements)
        {
            <tr>
                <td>
                    <select class="form-select"
                            @bind="requirement.Stat">

                        @foreach (var stat in Enum.GetValues<GenerationStat>())
                        {
                            <option value="@stat">
                                @stat
                            </option>
                        }

                    </select>
                </td>

                <td>
                    <input type="number"
                           class="form-control"
                           step="0.01"
                           min="0"
                           max="1"
                           @bind="requirement.Weight" />
                </td>

                <td>
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="() => RemoveRequirement(requirement)">
                        Remove
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<button type="button"
        class="btn btn-secondary"
        @onclick="AddRequirement">
    + Add Stat
</button>

<button type="button"
        class="btn btn-primary"
        @onclick="Create">
    Create Discipline
</button>

@code {

    private CreateCompetitionDisciplineWithClassDto dto = new()
    {
        Requirements = new List<CreateCompetitionStatRequirementDto>
        {
            new()
        }
    };

    private void AddRequirement()
    {
        dto.Requirements.Add(
            new CreateCompetitionStatRequirementDto()
        );
    }

    private void RemoveRequirement(
        CreateCompetitionStatRequirementDto requirement)
    {
        dto.Requirements.Remove(requirement);
    }

    private async Task Create()
    {
        await CompetitionClient.CreateCompetitionDisciplineClassAsync(dto);
    }
}

