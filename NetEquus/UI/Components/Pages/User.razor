@using UI.API.Clients
@using UI.Auth
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject AuthService AuthService
@attribute [Authorize]
@inject ArtistClient HorseArtistCLient
@page "/user"

    <p>Welcome back to @AuthService.Username.</p>

    
<button class="btn btn-primary w-100" @onclick="ApplyAsync">
    Appply
</button>


@code {

    private async Task ApplyAsync()
    {
        var response = await HorseArtistCLient.ApplyForArtistAsync();
    }
}
