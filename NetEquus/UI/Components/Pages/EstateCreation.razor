@page "/estatecreation"
@using Application.EstateApp.EstateDtos
@using Application.SharedApp.OwnershipDtos
@using Microsoft.AspNetCore.Authorization
@using Shared.Dtos.UserDtos
@using Shared.Dtos.WrapperDto
@using UI.API.Clients
@inject EstateClient EstateClient
@rendermode InteractiveServer
@attribute [Authorize]


<h3 class="mb-4">Register Here</h3>

<div class="container">
    <div class="card shadow p-4 col-md-6 mx-auto">

        <h4 class="mb-4 text-center">Join NetEquus</h4>

 
        <div class="mb-3">
            <label class="form-label">Estate Name</label>
            <input class="form-control" @bind="newEstate.Estate.EstateName" />
        </div>



        <button class="btn btn-primary w-100" @onclick="CreateAsync">
            Register
        </button>

    </div>
</div>

@code {
    private CreateEstateRequest newEstate = new CreateEstateRequest
    {
        Estate = new EstateCreationDto(),
        Ownership = new EstateOwnershipDto()
    };
    private string? responseMessage;

    private async Task CreateAsync()
    {
        var response = await EstateClient.CreateEstateAsync(newEstate);

        if (response.IsSuccessStatusCode)
        {
            responseMessage = "User created successfully!";
            newEstate = new CreateEstateRequest();
        }
        else
        {
            responseMessage = response.StatusCode.ToString();
            var error = await response.Content.ReadAsStringAsync();
            responseMessage = $"Registration failed: {error}";
        }
    }
}