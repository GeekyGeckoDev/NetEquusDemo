@page "/login"
@using Microsoft.AspNetCore.Components.Authorization
@using Shared.Dtos.UserDtos
@using UI.API.ApiClients
@using UI.API.Clients
@using UI.Auth

@inject AuthClient AuthClient
@inject AuthManager AuthManager
@inject CheckClient Check
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

@rendermode InteractiveServer

<div class="front-page">

    <div class="FrontPages front-page-login">
        <div class="front-page-content">

            <h1>NETEQUUS</h1>
            <h2>Welcome Back</h2>

            @if (!string.IsNullOrEmpty(responseMessage))
            {
                <div class="alert alert-info">
                    @responseMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input class="form-control"
                       @bind="loginUser.Email" />
            </div>

            <div class="mb-3">
                <label class="form-label">Password</label>
                <input type="password"
                       class="form-control"
                       @bind="loginUser.Password" />
            </div>

            <button class="btn btn-primary w-100"
                    @onclick="LoginUserAsync">
                Login
            </button>

        </div>
    </div>

    <div class="FrontPages front-page-hero">
        <div class="front-page-content">

            <h2>Hero Horse</h2>
            <p>Adult horse portrait and foal composition.</p>

        </div>
    </div>

    <div class="FrontPages front-page-studbook">
        <div class="front-page-content">

            <h2>From the Studbook</h2>
            <p>Featured horses will go here.</p>

        </div>
    </div>

    <div class="FrontPages front-page-extra">
        <div class="front-page-content">

            <h2>Discover NetEquus</h2>
            <p>Breeding, bloodlines and competition.</p>

        </div>
    </div>

</div>

@code {

    private LoginDto loginUser = new();
    private string? responseMessage;

    private async Task LoginUserAsync()
    {
        var success = await AuthManager.LoginAsync(loginUser);

        if (success)
        {
            await AuthManager.RefreshUserFromApi();
            responseMessage = "Login successful!";
            await Check.ProcessDueFoalingsAsync();
            Nav.NavigateTo("/test");
        }
        else
        {
            responseMessage = "Invalid login.";
        }
    }
}