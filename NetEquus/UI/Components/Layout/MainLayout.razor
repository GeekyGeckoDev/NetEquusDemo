@using UI.Auth
@inherits LayoutComponentBase
@inject AuthManager AuthManager

<div class="page">

    <main>
        <TopNav></TopNav>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await AuthManager.RefreshUserFromApi();
    }
}